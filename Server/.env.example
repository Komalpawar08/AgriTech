# AgriTech Server Environment Variables
# Copy this file to .env and fill in the values

# MongoDB connection string (required for data persistence)
# Local:  mongodb://localhost:27017/agritech
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/agritech
MONGO_URI=mongodb://localhost:27017/agritech

# JWT secret key - use a long random string in production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Server port (optional, defaults to 5000)
PORT=5000

# Frontend URL for CORS (optional, defaults to http://localhost:5173)
CLIENT_URL=http://localhost:5173

# OpenWeatherMap API key (optional - get free key at https://openweathermap.org/api)
# Without this, the weather feature shows a configuration message
OPENWEATHER_API_KEY=
